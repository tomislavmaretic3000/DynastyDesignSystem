{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "dependsOn": ["@dynasty-ds/ui#build"],
      "cache": false,
      "persistent": true
    },
    "build-storybook": {
      "dependsOn": ["@dynasty-ds/ui#build"],
      "outputs": ["storybook-static/**"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    "lint": {}
  }
}
