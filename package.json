{
  "name": "dynasty-design-system",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "storybook": "turbo run storybook --filter=@dynasty-ds/storybook",
    "build-storybook": "turbo run build-storybook --filter=@dynasty-ds/storybook",
    "tokens": "pnpm --filter=@dynasty-ds/tokens run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
